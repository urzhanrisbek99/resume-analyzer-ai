# --- Language model (optional) --------------------------------------------
# The deterministic rule engine runs entirely without these. A key only unlocks
# the suggestion layer, which receives PII-redacted text and never the file.
#
# Which vendor backs the provider is a deployment decision: the application code
# depends on the `LlmProvider` interface, not on any SDK.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# Hard cap on tokens per suggestion request (cost guard).
LLM_MAX_OUTPUT_TOKENS=2048

# --- Rate limiting --------------------------------------------------------
# Requests per minute per IP for the suggestion endpoint.
RATE_LIMIT_PER_MINUTE=10

# --- Public ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Resume Analyzer AI
