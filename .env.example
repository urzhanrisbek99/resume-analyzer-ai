# --- LLM enhancement (optional) -------------------------------------------
# The deterministic engine runs entirely without this key. The key only
# unlocks the "AI suggestions" layer, which receives PII-redacted text.
ANTHROPIC_API_KEY=

# Model used for suggestion generation.
ANTHROPIC_MODEL=claude-sonnet-5

# Hard cap on tokens per suggestion request (cost guard).
LLM_MAX_OUTPUT_TOKENS=2048

# --- Rate limiting --------------------------------------------------------
# Requests per minute per IP for the /api/enhance route.
RATE_LIMIT_PER_MINUTE=10

# --- Public ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Resume Analyzer AI
