{
  "name": "resume-analyzer-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ATS-aware resume analyzer with a deterministic rule engine and optional LLM enhancement. Feature-Sliced Design.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run pdf-worker && next dev",
    "build": "npm run pdf-worker && next build",
    "start": "next start",
    "pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,css,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@tanstack/react-query": "^5.104.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.4"
  }
}
