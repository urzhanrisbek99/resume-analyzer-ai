{
  "name": "resume-analyzer-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ATS-aware resume analyzer with a deterministic rule engine and optional LLM enhancement. Feature-Sliced Design.",
  "license": "MIT",
  "author": "Urzhan Rysbek <urzhanrisbek99@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urzhanrisbek99/resume-analyzer-ai.git"
  },
  "homepage": "https://github.com/urzhanrisbek99/resume-analyzer-ai#readme",
  "bugs": {
    "url": "https://github.com/urzhanrisbek99/resume-analyzer-ai/issues"
  },
  "keywords": [
    "resume",
    "cv",
    "ats",
    "applicant-tracking-system",
    "resume-parser",
    "recruiting",
    "feature-sliced-design",
    "nextjs"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run pdf-worker && next dev",
    "build": "npm run pdf-worker && next build",
    "start": "next start",
    "pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,css,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-boundaries": "^7.2.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.5"
  }
}
